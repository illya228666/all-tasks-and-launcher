<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>$(RepositoryTargetFramework)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Launcher.Pet\Launcher.Pet.csproj" /></ItemGroup>
  <ItemGroup><None Update="Resources\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Update="Resources\sumrak\**;Resources\ruins\gothic\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" /></ItemGroup>
  <ItemGroup><None Update="Resources\sumrak\*\hat\*.png;Resources\sumrak\*\no-hat\*.png;Resources\ruins\gothic\assets\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><None Update="Resources\sumrak\*\hat\sheet-transparent.png;Resources\sumrak\*\no-hat\sheet-transparent.png" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" /></ItemGroup>
  <ItemGroup><None Update="Resources\sumrak\bundle.json;Resources\ruins\gothic\catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Compile Update="Windows\*.cs;Debug\*.cs"><SubType>Code</SubType></Compile></ItemGroup>
</Project>


