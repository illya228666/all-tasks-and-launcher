<UserControl x:Class="EspController.Controls.DiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="340" UseLayoutRounding="True">
    <Border CornerRadius="20" BorderBrush="#375B64" BorderThickness="1" Padding="24">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#203A43" Offset="0" /><GradientStop Color="#1A2030" Offset="0.75" /></LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid ClipToBounds="True" Margin="-12,0,12,0">
                <Ellipse x:Name="Shadow" Fill="#070D14" Width="145" Height="26" VerticalAlignment="Bottom" Margin="0,0,0,18" Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="ShadowScale" /></Ellipse.RenderTransform>
                </Ellipse>
                <Viewport3D x:Name="Scene" IsHitTestVisible="False" />
                <TextBlock Text="LIVE VOM ESP8266" Foreground="#6EE7CE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="AUTONOMER WÜRFEL · IO v4" Foreground="#6EE7CE" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="Der nächste Wurf gehört dem Zufall." FontSize="25" FontWeight="SemiBold" Margin="0,10,0,12" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ResultText" Text="—" FontSize="56" FontWeight="Bold" Foreground="#F1F5FC" />
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock x:Name="StatusText" Text="Warte auf ESP …" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock x:Name="SequenceText" Text="Ergebnis kommt von der Platine" Foreground="#A4B0C8" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Ein Wurf alle 5 Sekunden. Die LEDs auf der Platine zeigen dieselbe Augenzahl." Foreground="#A4B0C8" FontSize="12" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
